TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
OPENAI_API_KEY=your_openai_api_key_here

# Optional: bind-mount host folder for Hermes data. If unset, a Docker named volume is used.
# Windows (PowerShell often has no HOME): HERMES_HOST_DATA=C:/Users/YourName/.hermes
# Linux/macOS: HERMES_HOST_DATA=/home/yourname/.hermes
# HERMES_HOST_DATA=
